--[[   Ellion's FDDA Auto Helmet: consuming an eatable item while wearing a helmet takes the helmet off and eats
       the item. Optionally (MCM "Require modifier key") only while the modifier key is held. The helmet is put
       back on after the item is consumed only if MCM "Re-equip helmet after use" is enabled, otherwise it stays off.
       Uses FDDA Redone (447- FDDA Redone - lizzardman) animations:
       unequip animation (cosmetic, helmet is moved instantly), eat animation (item use), equip animation.
       Wraps FDDA's public liz_fdda_redone_consumables.modifiedAOIBU in on_game_start. Both FDDA's hook and its
       western goods patch look that function up at call time, so this works regardless of script load order.
       Base itms_manager checks (e.g. required tools) run before it, and a refused use (flags.ret_value == false)
       is respected.
       The removed helmet is also registered with FDDA's helmet hotkey so its toggle key can put it back on.
       The helmet is only taken off for items it blocks (helm = false in FDDA's animations_settings); headgear
       listed in FDDA's headgear_item_use_whitelist.ltx is left on.

       Instant helmet unequip (MCM "Instant helmet unequip"): when the helmet is taken off from the inventory or with
       FDDA's helmet hotkey, it leaves the slot immediately so it can be equipped again right away. FDDA's unequip
       animation, fade and nightvision steps are then played as cosmetics only. Only applies while FDDA's headgear
       animations are enabled. This feature was previously the separate "Ellion's FDDA Instant Helmet Inv" mod
       and is now merged into this one. Disable or uninstall that mod when using this one.   ]] --

---@class EllionsAutoHelmetAction
---@field name string Action name, used for lam2 bookkeeping.
---@field tag string|nil Tag used to find the action in the lam2 queue.
---@field section string|nil Helmet section the cosmetic action plays for.
---@field item_id number|nil Id of the item the consume action eats.
---@field can_skip boolean|nil False if the action must not be skipped by lam2.
---@field execute fun(self: EllionsAutoHelmetAction, elapsed_time: number): number Runs the action and returns a lam2 state.

--items that FDDA Redone would eat with animation (same check as liz_fdda_redone_consumables)
local animations_settings_ini = ini_file("items\\items\\animations_settings.ltx")
--headgear that doesn't block eating (shipped by FDDA Redone, 447)
local ini_helmet_whitelist = ini_file("items\\items\\headgear_item_use_whitelist.ltx")

--helmets that don't require nvg removal to equip or unequip (copy of the local table in the original module)
local cosmetic_nvg_blacklist = {
    ["helm_bandana"] = true,
    ["helm_rp_bala"] = true,
    ["helm_resp"] = true,
    ["helm_cloth_mask"] = true,
}

local cosmetic_ini_blacklist = ini_file("items\\items\\headgear_blacklist.ltx")

local WD_GROUP = "ellions_auto_helmet"
local WD_NAME = "watchdog"
local WD_DELAY = 0.5

--cached MCM values
local cfg_enabled = true
local cfg_modifier = 2
local cfg_use_modifier = true
local cfg_reequip = false
local cfg_instant_unequip = true

--helmet taken off by the current consume sequence (object id and section)
local pending_helmet_id = nil
local pending_section = nil
--true if the helmet should be put back on after the item is consumed (snapshot taken when the helmet is taken off)
local pending_reequip = false

--true while the watchdog time event exists in the _g time event queue
local wd_active = false

--original liz_fdda_redone_consumables.modifiedAOIBU, captured once in on_game_start
local orig_modified_aoibu = nil

--FDDA Redone headgear module (liz_fdda_redone_headgear_animations), resolved in on_game_start
local headgear_module = nil

--originals of FDDA's headgear unequip functions, captured once in on_game_start
local original_on_unequip = nil
local original_on_toggle_unequip = nil

---Single logging entry point for this mod. Calls printf with one argument only (no format args).
---@param message string Full log line, including the "[Ellion FDDA Auto Helmet]" prefix and the "!" or "~" marker.
---@return nil
local function log_message(message)
    printf(message)
end

--- ----------------------------------------------------------------------
--- init
--- ----------------------------------------------------------------------

---Registers callbacks and installs the FDDA hooks (consume wrapper and instant helmet unequip), once per game start.
---@return nil
function on_game_start()
    RegisterScriptCallback("on_option_change", ellions_auto_helmet_refresh_config)
    RegisterScriptCallback("actor_on_first_update", ellions_auto_helmet_actor_on_first_update)
    RegisterScriptCallback("actor_on_before_death", ellions_auto_helmet_actor_on_before_death)
    RegisterScriptCallback("save_state", on_save_state)
    RegisterScriptCallback("load_state", on_load_state)
    lam2.Subscribe("on_anim_queue_stop", ellions_auto_helmet_on_anim_queue_stop)
    ellions_auto_helmet_refresh_config()

    headgear_module = liz_fdda_redone_headgear_animations
    if not headgear_module then
        log_message("! [Ellion FDDA Auto Helmet] liz_fdda_redone_headgear_animations not found - auto helmet and instant helmet unequip disabled")
        return
    end

    --instant unequip: replace FDDA's headgear unequip functions once, the originals are called when the feature is off
    if not original_on_unequip then
        original_on_unequip = headgear_module.on_unequip
        original_on_toggle_unequip = headgear_module.on_toggle_unequip
        headgear_module.on_unequip = ellions_auto_helmet_on_unequip
        headgear_module.on_toggle_unequip = ellions_auto_helmet_on_toggle_unequip
    end

    --auto helmet: wrap FDDA's modifiedAOIBU once
    local consumables_module = liz_fdda_redone_consumables
    if consumables_module and type(consumables_module.modifiedAOIBU) == "function" then
        if not orig_modified_aoibu then
            orig_modified_aoibu = consumables_module.modifiedAOIBU
            consumables_module.modifiedAOIBU = ellions_auto_helmet_modified_aoibu
        end
    else
        log_message("! [Ellion FDDA Auto Helmet] liz_fdda_redone_consumables.modifiedAOIBU not found - auto helmet disabled")
    end
end

---Reads the MCM values into the cached config variables. Runs on game start and when options change.
---@return nil
function ellions_auto_helmet_refresh_config()
    local mcm = ellion_fdda_auto_helmet_mcm
    if mcm and mcm.get_config then
        cfg_enabled = mcm.get_config("general/enable") and true or false
        cfg_modifier = mcm.get_config("general/modifier") or 2
        cfg_use_modifier = mcm.get_config("general/use_modifier") and true or false
        cfg_reequip = mcm.get_config("general/reequip") and true or false
        cfg_instant_unequip = mcm.get_config("general/instant_unequip") and true or false
    end
end

--- ----------------------------------------------------------------------
--- utils
--- ----------------------------------------------------------------------

---Checks whether FDDA's consumables option is enabled in its MCM.
---@return boolean is_enabled True if FDDA Redone consumables animations are enabled.
function ellions_auto_helmet_fdda_consumables_enabled()
    return liz_fdda_redone_mcm ~= nil and liz_fdda_redone_mcm.get_config("consumables/enable") and true or false
end

---Checks whether the given modifier key (1 shift, 2 ctrl, 3 alt) is held.
---@param modifier_value number Modifier key index from MCM (1, 2 or 3).
---@return boolean is_held True if the modifier key is held.
function ellions_auto_helmet_is_modifier_held(modifier_value)
    if modifier_value ~= 1 and modifier_value ~= 2 and modifier_value ~= 3 then return false end
    if ui_mcm and ui_mcm.get_mod_key then
        return ui_mcm.get_mod_key(modifier_value) and true or false
    end
    if modifier_value == 1 then
        return (key_state(DIK_keys.DIK_LSHIFT) or 0) ~= 0 or (key_state(DIK_keys.DIK_RSHIFT) or 0) ~= 0
    elseif modifier_value == 2 then
        return (key_state(DIK_keys.DIK_LCONTROL) or 0) ~= 0 or (key_state(DIK_keys.DIK_RCONTROL) or 0) ~= 0
    else
        return (key_state(DIK_keys.DIK_LMENU) or 0) ~= 0 or (key_state(DIK_keys.DIK_RMENU) or 0) ~= 0
    end
end

---Refreshes the mask HUD overlay after the helmet changed slot, if the mask HUD option is on.
---@return nil
function ellions_auto_helmet_update_mask_overlay()
    if ui_options and ui_options.get and ui_options.get("video/player/mask_hud") and actor_effects and actor_effects.Update_Mask then
        actor_effects.Update_Mask(db.actor)
    end
end

---Clears the pending helmet state and removes the watchdog event.
---Never call from inside ellions_auto_helmet_watchdog (time event callback).
---@return nil
function ellions_auto_helmet_clear_pending()
    pending_helmet_id = nil
    pending_section = nil
    pending_reequip = false
    RemoveTimeEvent(WD_GROUP, WD_NAME)
    wd_active = false
end

---Creates the watchdog time event, or resets it if it already exists. Safe to call from anywhere.
---@param delay number|nil Seconds until the watchdog runs. Defaults to WD_DELAY.
---@return nil
function ellions_auto_helmet_schedule_watchdog(delay)
    if wd_active then
        ResetTimeEvent(WD_GROUP, WD_NAME, delay or WD_DELAY)
    else
        CreateTimeEvent(WD_GROUP, WD_NAME, delay or WD_DELAY, ellions_auto_helmet_watchdog)
        wd_active = true
    end
end

---Returns the pending helmet if it is still in the ruck and slot 12 is free.
---@return game_object|nil pending_helmet The pending helmet object, or nil if it is not usable.
function ellions_auto_helmet_get_pending_helmet()
    if pending_helmet_id == nil then return nil end
    local helmet_object = level.object_by_id(pending_helmet_id)
    if helmet_object and helmet_object:parent() and helmet_object:parent():id() == db.actor:id() and db.actor:item_in_slot(12) == nil then
        return helmet_object
    end
    return nil
end

---Checks whether the given item is the helmet currently in the headgear slot (12).
---@param item_object game_object Item to check.
---@return boolean is_worn True if the item is the one in slot 12.
function ellions_auto_helmet_is_helmet_in_slot(item_object)
    local worn_helmet = db.actor:item_in_slot(12)
    return worn_helmet ~= nil and worn_helmet:id() == item_object:id()
end

---Checks whether the instant helmet unequip should replace FDDA's animated unequip.
---Needs the MCM option on and FDDA's headgear animations enabled in its MCM.
---@return boolean is_active True if instant helmet unequip is active.
function ellions_auto_helmet_is_instant_unequip_active()
    if not cfg_instant_unequip then return false end
    if not liz_fdda_redone_mcm then return false end
    return liz_fdda_redone_mcm.get_config("headgear_anm/enable") == true
end

--- ----------------------------------------------------------------------
--- action templates
--- ----------------------------------------------------------------------

--actions here added in backwards order (from bottom to top) cuz we add them at the beginning of the queue (lam2.add_action_first)
---Builds the cosmetic unequip action: FDDA's unequip animation, fade and nightvision steps for the helmet section.
---@param section string Helmet section.
---@return EllionsAutoHelmetAction action The lam2 action.
function ta_ellions_auto_helmet_unequip_cosmetic(section)
    ---@type EllionsAutoHelmetAction
    local action = {}
    action.name = "ellions_auto_helmet_headgear_unequip_cosmetic"
    action.section = section
    action.execute = function (self, elapsed_time)
        --animation
        if not cosmetic_ini_blacklist:section_exist(self.section) then
            lam2.add_action_first(headgear_module.ta_animation_unequip(self.section))
        end
        --fade
        if headgear_module.is_use_fade(self.section) then
            lam2.add_action_first(headgear_module.ta_unequip_fade())
        end
        --nvg
        if not cosmetic_nvg_blacklist[self.section] then
            lam2.add_action_first(headgear_module.ta_try_set_nightvision(false))
        end
        return lam2.states.success
    end
    return action
end

--queued after the eat action; plays the FDDA equip animation if the helmet can still be put back on
---Builds the action that puts the pending helmet back on after the item was eaten.
---@return EllionsAutoHelmetAction action The lam2 action.
function ta_ellions_auto_helmet_reequip()
    ---@type EllionsAutoHelmetAction
    local action = {}
    action.tag = "ellions_auto_helmet_reequip"
    action.name = "ellions_auto_helmet_helmet_reequip"
    action.can_skip = false
    action.execute = function (self, elapsed_time)
        local helmet_object = ellions_auto_helmet_get_pending_helmet()
        if helmet_object then
            headgear_module.on_toggle_equip(helmet_object)
        end
        ellions_auto_helmet_clear_pending()
        return lam2.states.success
    end
    return action
end

--waits until the helmet is out of slot 12, eats the item (FDDA eat animation) and queues the re-equip after it
---Builds the action that waits for the helmet to leave slot 12, then eats the item.
---@param item_id number Id of the eatable item.
---@return EllionsAutoHelmetAction action The lam2 action.
function ta_ellions_auto_helmet_consume(item_id)
    ---@type EllionsAutoHelmetAction
    local action = {}
    action.name = "ellions_auto_helmet_consume"
    action.tag = "ellions_auto_helmet_consume"
    action.can_skip = false
    action.item_id = item_id
    action.execute = function (self, elapsed_time)
        if db.actor:item_in_slot(12) ~= nil then
            if elapsed_time < 3 then
                return lam2.states.running
            end
            --helmet is still on, nothing to re-equip
            ellions_auto_helmet_clear_pending()
            return lam2.states.success
        end
        local item_object = level.object_by_id(self.item_id)
        if item_object and item_object:parent() and item_object:parent():id() == db.actor:id() then
            if liz_fdda_redone_consumables and liz_fdda_redone_consumables.perform_item_use then
                liz_fdda_redone_consumables.perform_item_use(item_object)
            else
                db.actor:eat(item_object)
            end
        end
        --added after FDDA's eat action, so the order is unequip, eat, re-equip
        if pending_reequip then
            lam2.add_action(ta_ellions_auto_helmet_reequip())
        else
            --helmet stays off
            ellions_auto_helmet_clear_pending()
        end
        return lam2.states.success
    end
    return action
end

--- ----------------------------------------------------------------------
--- instant helmet unequip
--- ----------------------------------------------------------------------

---Instant unequip from the inventory UI: removes the helmet from slot 12 through FDDA's UI handler
---(or moves it to the ruck) and queues the cosmetic steps. Called inside pcall.
---@param item_object game_object Helmet being unequipped.
---@param bag_name string Bag the helmet was unequipped from.
---@return nil
function ellions_auto_helmet_instant_unequip_from_ui(item_object, bag_name)
    local section = item_object:section()
    local inventory_module = zzzz_liz_fdda_redone_ui_inventory
    if inventory_module and inventory_module.Unequip then
        inventory_module.Unequip(item_object, bag_name)
    else
        db.actor:move_to_ruck(item_object)
    end
    ellions_auto_helmet_update_mask_overlay()
    lam2.add_action(ta_ellions_auto_helmet_unequip_cosmetic(section))
end

---Instant unequip from FDDA's helmet hotkey: moves the helmet to the ruck and queues the cosmetic steps. Called inside pcall.
---@param item_object game_object Helmet being taken off.
---@return nil
function ellions_auto_helmet_instant_unequip_from_hotkey(item_object)
    local section = item_object:section()
    db.actor:move_to_ruck(item_object)
    ellions_auto_helmet_update_mask_overlay()
    lam2.add_action(ta_ellions_auto_helmet_unequip_cosmetic(section))
end

---Replacement for FDDA's headgear on_unequip (inventory UI). Takes the instant path when instant unequip is active,
---otherwise calls the original once with the same arguments.
---@param item_object game_object Helmet being unequipped from the inventory.
---@param bag_name string Bag the helmet was unequipped from.
---@return any result Return value of the original on_unequip when the instant path is not used.
function ellions_auto_helmet_on_unequip(item_object, bag_name)
    if not ellions_auto_helmet_is_instant_unequip_active() then
        return original_on_unequip(item_object, bag_name)
    end
    local ok, error_message = pcall(ellions_auto_helmet_instant_unequip_from_ui, item_object, bag_name)
    if not ok then
        log_message("! [Ellion FDDA Auto Helmet] instant helmet unequip failed: " .. tostring(error_message))
        --our part did not move the helmet, let FDDA handle it
        if ellions_auto_helmet_is_helmet_in_slot(item_object) then
            return original_on_unequip(item_object, bag_name)
        end
    end
    return nil
end

---Replacement for FDDA's headgear on_toggle_unequip (helmet hotkey). Takes the instant path only when the item
---is the helmet in slot 12 and instant unequip is active, otherwise calls the original once.
---@param item_object game_object Helmet being taken off.
---@return any result Return value of the original on_toggle_unequip when the instant path is not used.
function ellions_auto_helmet_on_toggle_unequip(item_object)
    if not ellions_auto_helmet_is_instant_unequip_active() or not ellions_auto_helmet_is_helmet_in_slot(item_object) then
        return original_on_toggle_unequip(item_object)
    end
    local ok, error_message = pcall(ellions_auto_helmet_instant_unequip_from_hotkey, item_object)
    if not ok then
        log_message("! [Ellion FDDA Auto Helmet] instant helmet unequip failed: " .. tostring(error_message))
        --our part did not move the helmet, let FDDA handle it
        if ellions_auto_helmet_is_helmet_in_slot(item_object) then
            return original_on_toggle_unequip(item_object)
        end
    end
    return nil
end

--- ----------------------------------------------------------------------
--- safety net
--- ----------------------------------------------------------------------

--lam2 queue was aborted (death, abort) and our re-equip action may have been purged
--run the check on a time event, because lam2 is still resetting inside the callback
---Schedules the watchdog if a helmet is still pending when the lam2 queue stops.
---@return nil
function ellions_auto_helmet_on_anim_queue_stop()
    if pending_helmet_id ~= nil then
        ellions_auto_helmet_schedule_watchdog(0.1)
    end
end

--time event callback: must not call RemoveTimeEvent/CreateTimeEvent (ProcessEventQueue is iterating)
--returns false to keep the event, true to remove it
---Time event callback. Re-equips the pending helmet once the lam2 queue is idle, or keeps waiting.
---@return boolean remove_event True to remove the event, false to keep it.
function ellions_auto_helmet_watchdog()
    if pending_helmet_id == nil then
        wd_active = false
        return true
    end
    if not db.actor or not db.actor:alive() then
        pending_helmet_id = nil
        pending_section = nil
        pending_reequip = false
        wd_active = false
        return true
    end
    if lam2.is_running() or lam2.has_queued_actions() then
        ResetTimeEvent(WD_GROUP, WD_NAME, WD_DELAY)
        return false
    end
    local helmet_object = ellions_auto_helmet_get_pending_helmet()
    if helmet_object and pending_reequip then
        headgear_module.on_toggle_equip(helmet_object)
    end
    pending_helmet_id = nil
    pending_section = nil
    pending_reequip = false
    wd_active = false
    return true
end

--- ----------------------------------------------------------------------
--- main
--- ----------------------------------------------------------------------

---Decides whether the helmet must come off for this use.
---@param item_object game_object Item being used.
---@param flags table FDDA use flags; flags.ret_value is false when FDDA refuses the use.
---@return boolean should_take_off True if the helmet should be taken off for this use.
function ellions_auto_helmet_should_take_helmet_off(item_object, flags)
    if not cfg_enabled or not headgear_module then return false end
    if not flags.ret_value then return false end
    if pending_helmet_id ~= nil then return false end
    if cfg_use_modifier and not ellions_auto_helmet_is_modifier_held(cfg_modifier) then return false end
    if not db.actor or not db.actor:alive() then return false end
    if not ellions_auto_helmet_fdda_consumables_enabled() then return false end
    if not animations_settings_ini:section_exist(item_object:section()) then return false end
    --only items the helmet blocks (same rule as FDDA strict helmets: helm = false; missing or true means usable with a helmet on)
    if animations_settings_ini:r_bool_ex(item_object:section(), "helm") ~= false then return false end
    --FDDA would refuse the use anyway
    if IsMoveState("mcClimb") or IsMoveState("mcSprint") then return false end
    local helmet = db.actor:item_in_slot(12)
    if not helmet then return false end
    --light headgear (bandana, balaclava, cloth mask, hardhats...) doesn't need to come off
    if ini_helmet_whitelist:section_exist(helmet:section()) then return false end
    return true
end

---Takes the helmet off and queues the consume when the use needs it.
---@param item_object game_object Item being used.
---@param flags table FDDA use flags; flags.ret_value is set to false when the use is taken over.
---@return boolean handled True if the use was handled (helmet taken off, consume queued), false otherwise.
function ellions_auto_helmet_try_take_helmet_off(item_object, flags)
    if not ellions_auto_helmet_should_take_helmet_off(item_object, flags) then
        return false
    end

    local helmet = db.actor:item_in_slot(12)
    pending_helmet_id = helmet:id()
    pending_section = helmet:section()
    pending_reequip = cfg_reequip

    --move the helmet out of the slot before FDDA checks it (strict helmet mode), cosmetic unequip is queued
    db.actor:move_to_ruck(helmet)
    --tell FDDA's helmet hotkey which helmet was taken off, so the toggle key can put it back on
    local hotkey = liz_fdda_redone_headgear_animations_hotkey
    if hotkey and hotkey.set_last_helmet then
        hotkey.set_last_helmet(helmet)
    end
    ellions_auto_helmet_update_mask_overlay()
    lam2.add_action(ta_ellions_auto_helmet_unequip_cosmetic(pending_section))

    --cancel the engine use, the item is eaten by the consume action once the helmet is out of the slot
    flags.ret_value = false
    lam2.add_action(ta_ellions_auto_helmet_consume(item_object:id()))
    ellions_auto_helmet_schedule_watchdog()
    return true
end

---Replacement for liz_fdda_redone_consumables.modifiedAOIBU. Handles the auto helmet, otherwise calls
---FDDA's original once with the same arguments.
---@param item_object game_object Item being used.
---@param flags table FDDA use flags.
---@return any result Return value of the original modifiedAOIBU when the use is not handled here.
function ellions_auto_helmet_modified_aoibu(item_object, flags)
    local ok, handled = pcall(ellions_auto_helmet_try_take_helmet_off, item_object, flags)
    if not ok then
        log_message("! [Ellion FDDA Auto Helmet] auto helmet failed, FDDA handles the use: " .. tostring(handled))
        handled = false
    end
    if handled then return end
    return orig_modified_aoibu(item_object, flags)
end

--- ----------------------------------------------------------------------
--- persistance
--- ----------------------------------------------------------------------

---Saves the pending helmet id, only when a re-equip is wanted.
---@param save_data table Save data table provided by the save_state callback.
---@return nil
function on_save_state(save_data)
    if pending_helmet_id ~= nil and pending_reequip then
        save_data.ellions_auto_helmet_pending_helmet_id = pending_helmet_id
    end
end

---Restores the pending helmet id from save data.
---@param save_data table Save data table provided by the load_state callback.
---@return nil
function on_load_state(save_data)
    pending_helmet_id = save_data.ellions_auto_helmet_pending_helmet_id
    --legacy fallback: migrates saves made under the old mod name (key ellions_hoc_pending_helmet_id)
    if pending_helmet_id == nil then
        pending_helmet_id = save_data.ellions_hoc_pending_helmet_id
    end
    save_data.ellions_hoc_pending_helmet_id = nil
    pending_section = nil
    --only saved when a re-equip was wanted
    if pending_helmet_id ~= nil then
        pending_reequip = true
    else
        pending_reequip = false
    end
end

---Re-registers the FDDA headgear handler, then puts a pending helmet back into slot 12 after a load.
---@return nil
function ellions_auto_helmet_actor_on_first_update()
    --re-register the headgear handler so the inventory UI uses our instant unequip override
    local inventory_module = zzzz_liz_fdda_redone_ui_inventory
    if headgear_module and inventory_module and inventory_module.Add_Handler then
        local ok, error_message = pcall(
            inventory_module.Add_Handler,
            "headgear",
            headgear_module.predicate,
            headgear_module.on_eqiup,
            headgear_module.on_unequip,
            headgear_module.on_drop,
            headgear_module.on_swap
        )
        if not ok then
            log_message("! [Ellion FDDA Auto Helmet] could not re-register the headgear handler: " .. tostring(error_message))
        end
    end

    if pending_helmet_id == nil then return end
    local id = pending_helmet_id
    local found = nil
    ---Iterate-ruck callback that finds the pending helmet by id.
    ---@param actor_object game_object Actor owning the ruck.
    ---@param ruck_item game_object Item being iterated.
    ---@return nil
    local function find_pending_helmet(actor_object, ruck_item)
        if ruck_item:id() == id then
            found = ruck_item
        end
    end
    db.actor:iterate_ruck(find_pending_helmet, nil)
    if found and db.actor:item_in_slot(12) == nil then
        db.actor:move_to_slot(found, 12)
        ellions_auto_helmet_update_mask_overlay()
    end
    ellions_auto_helmet_clear_pending()
end

---Clears the pending helmet state when the actor dies.
---@return nil
function ellions_auto_helmet_actor_on_before_death()
    ellions_auto_helmet_clear_pending()
end
